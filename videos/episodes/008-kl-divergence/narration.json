  {
   "index": 10,
   "start": 156.733,
   "duration": 14.25,
   "end": 170.983,
   "text": "Maximum likelihood puts the data first, so a one-bell fit stretches over every hump. [pause 0.5] Variational inference approximates a Bayesian posterior with the model first, so it tends to settle on one hump.",
   "voice": "af_heart",
   "speed": 0.83,
   "cadence": "shaped",
